{
  "name": "@sssilvar/vv-wasm",
  "version": "0.1.0-rc.4",
  "description": "VTK WebAssembly surface visualizer with React bindings and a software renderer",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sssilvar/vv.git",
    "directory": "web"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vv.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "rc"
  },
  "scripts": {
    "build:wasm": "bash ../scripts/build-wasm.sh",
    "build": "pnpm run build:wasm && vite build --config vite.config.tsx && tsc",
    "dev": "vite --config vite.config.tsx",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "format": "oxfmt src demo tests stories .storybook scripts *.tsx",
    "format:check": "oxfmt --check src demo tests stories .storybook scripts *.tsx",
    "lint": "oxlint --deny-warnings src demo tests stories .storybook scripts",
    "test:e2e": "playwright test --config playwright.config.tsx",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "test:storybook": "playwright test --config playwright.storybook.config.tsx"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/react-vite": "10.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "10.6.1",
    "typescript": "~7.0.2",
    "vite": "^7.2.6"
  },
  "peerDependencies": {
    "react": "^19.2.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.8.1"
}
